# These are LOCAL DEVELOPMENT defaults — copy this file to .env and leave
# them as-is to run against a backend on localhost:5000.
#
# Vite bakes VITE_* variables into the built JS at build time (not read at
# runtime), so a committed .env is only ever useful for local dev. For the
# deployed frontend, production values are set directly in Render's
# dashboard under the frontend static site's Environment settings — NOT in
# a committed .env file — since Render rebuilds the frontend from source on
# every deploy and reads env vars from its own dashboard config at that
# build step. See README.md's "Environment Configuration" section.

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the backend — in development the Vite proxy handles this
# automatically, so you only need this for production builds
VITE_API_URL=http://localhost:5000/api

# ─── Socket.io ────────────────────────────────────────────────────────────────
# Backend server URL for Socket.io connection
VITE_SOCKET_URL=http://localhost:5000