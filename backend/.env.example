# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=30d

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Required by config/cloudinary.js — used for both avatar uploads
# (middleware/upload.js) and chat/session file attachments (uploadChatFile).
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
