# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=30d

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Default: openai/gpt-oss-120b (llama-3.3-70b-versatile was deprecated on free/dev tiers,
# 2026-08-16). Leave empty to use the default, or set a model from
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Required by config/cloudinary.js — used for both avatar uploads
# (middleware/upload.js) and chat/session file attachments (uploadChatFile).
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (verification + password reset) ───────────────────────────────────
# EMAIL_PROVIDER: "brevo" (HTTP API — works on Render free tier, which may
# block SMTP ports) or "console" (development only: prints emails to the log).
# Defaults to brevo when BREVO_API_KEY is set, otherwise console outside production.
EMAIL_PROVIDER=brevo
# Brevo → SMTP & API → API Keys. Never commit the real key.
BREVO_API_KEY=your-brevo-api-key
# Must be a sender address verified in Brevo (Senders & IPs → Senders).
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=SkillSwap
# CLIENT_URL (above) is also used to build the links inside emails,
# e.g. https://skillswap-frontend-cy48.onrender.com
